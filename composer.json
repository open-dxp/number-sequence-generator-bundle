{
  "name": "open-dxp/number-sequence-generator-bundle",
  "license": "GPL-3.0+",
  "type": "opendxp-bundle",
  "description": "OpenDXP Number Sequence Generator",
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "symfony/runtime": true
    }
  },
  "prefer-stable": true,
  "minimum-stability": "dev",
  "require": {
    "open-dxp/opendxp": "^1.0"
  },
  "require-dev": {
    "open-dxp/admin-bundle": "^1.0",
    "phpstan/phpstan": "^2.0",
    "symfony/dotenv": "^7.4",
    "symfony/runtime": "^7.4"
  },
  "autoload": {
    "psr-4": {
      "OpenDxp\\Bundle\\NumberSequenceGeneratorBundle\\": "src/"
    }
  },
  "extra": {
    "opendxp": {
      "bundles": [
        "OpenDxp\\Bundle\\NumberSequenceGeneratorBundle\\OpenDxpNumberSequenceGeneratorBundle"
      ]
    }
  }
}
